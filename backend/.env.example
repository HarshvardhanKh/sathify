# Copy to .env and adjust as needed. All settings have working defaults.

WEBSOCKET_PORT=8000
LOG_LEVEL=INFO

AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SECONDS=3.0
AUDIO_OVERLAP_SECONDS=0.5
AUDIO_BACKEND=soundcard

ASR_MODEL=base
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=auto
# ASR_LANGUAGE=en

CONTEXT_MAX_WORDS=20
CONTEXT_MAX_SECONDS=3.0
CONTEXT_SILENCE_THRESHOLD=0.8

AUDIO_QUEUE_MAXSIZE=50
TRANSCRIPT_QUEUE_MAXSIZE=100
TRANSLATION_QUEUE_MAXSIZE=100

TRANSLATOR_STRATEGY=hybrid
